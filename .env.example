# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Providers (Gemini Key Waterfall & HF Inference Providers)
# GEMINI_KEYS: Comma-separated list of Gemini API keys
GEMINI_KEYS=key1,key2,key3
HF_TOKEN=your_huggingface_access_token_here

# Facebook Graph API Credentials
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_TOKEN=your_long_lived_facebook_page_access_token_here

# LinkedIn API Credentials
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id_or_organization_id_here
# LinkedIn OAuth app (for the auth-expiry watcher + one-click re-auth).
# LINKEDIN_CLIENT_ID=your_linkedin_oauth_client_id_here
# LINKEDIN_CLIENT_SECRET=your_linkedin_oauth_client_secret_here
# LINKEDIN_CALLBACK_URL=https://forchi.myzelva.com/rest/oauth2-credential/callback

# Storage & Runtime Config
DATABASE_PATH=./data/forchi.db
NODE_ENV=production

# Auto-posting scheduler (2x/day: 08:00 + 16:00 UTC — FB both slots, LI 08:00 job-seeking + 16:00 project showcase)
# AUTO_MODE_DEFAULT: initial auto-mode state on first boot (default true).
# Can be toggled live from Telegram with "turn on/off auto mode".
AUTO_MODE_DEFAULT=true

# Chat/voice replies: gemini (default, fast ~seconds) or qwen (self-hosted, free but ~90s)
CHAT_PROVIDER=gemini

# Optional: fast free voice transcription via Groq Whisper (get a free key at console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here

# ── Web Search API Keys (current-events / factual grounding) ──
# Fallback order in code: Serper -> Exa -> Firecrawl -> Tavily -> DuckDuckGo (free, no key)
SERPER_API_KEY=your_serper_key_here
EXA_API_KEY=your_exa_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here
TAVILY_API_KEY=your_tavily_key_here

# Self-hosted LLM server (HF Space running Qwen2.5-7B GGUF via llama.cpp)
LLM_ENDPOINT=https://slymun-forchi.hf.space

# High-quality image generation (HF ZeroGPU Gradio Space, SDXL base 1.0)
ZEROGPU_ENDPOINT=https://slymun-forchi-img.hf.space

# ── ForChi Jobs agent (constant-auto job discovery + application workflow) ──
# JOBS_AUTO_APPLY: set true to actually SUBMIT applications (default false = dry-run,
#   the agent discovers/matches/writes/tailors but never submits). Flip this only
#   after you're happy with a dry-run cycle.
JOBS_AUTO_APPLY=false
# JOBS_NOTIFY_CHAT_ID: your Telegram chat id to receive the morning digest.
# JOBS_NOTIFY_CHAT_ID=123456789
# JOBS_SCAN_INTERVAL_MIN: how often the constant-auto loop scans (default 30).
# JOBS_SCAN_INTERVAL_MIN=30
# JOBS_DAILY_CAP: max applications submitted per day (default 10).
# JOBS_DAILY_CAP=10
# JOBS_MIN_SCORE: minimum match score (0-100) before a job is queued (default 70).
# JOBS_MIN_SCORE=70
# JOBS_MAX_PER_RUN: jobs processed per pipeline run (default 25).
# JOBS_MAX_PER_RUN=25
# JOBS_APPLY_WINDOW: UTC hour range (default 7-19 = 08:00-20:00 WAT) so timestamps look human.
# JOBS_APPLY_WINDOW=7-19
# JOBS_DB_PATH: jobs workflow SQLite file (default ./data/jobs.db).
# JOBS_DB_PATH=./data/jobs.db
# RESUME_PATH: base resume PDF used when no tailored PDF is available.
# RESUME_PATH=./data/resume/Agu_Victor_Chiedozie_Resum.pdf
