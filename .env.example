# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Providers (Gemini Key Waterfall & HF Inference Providers)
# GEMINI_KEYS: Comma-separated list of Gemini API keys
GEMINI_KEYS=key1,key2,key3
HF_TOKEN=your_huggingface_access_token_here

# Facebook Graph API Credentials
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_TOKEN=your_long_lived_facebook_page_access_token_here

# LinkedIn API Credentials
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id_or_organization_id_here

# Storage & Runtime Config
DATABASE_PATH=./data/forchi.db
NODE_ENV=production

# Self-hosted LLM server (HF Space running Qwen2.5-7B GGUF via llama.cpp)
LLM_ENDPOINT=https://slymun-forchi.hf.space
